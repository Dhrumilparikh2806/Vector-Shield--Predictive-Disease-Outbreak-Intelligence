# Backend Configuration
# Local development - leave as is
# For Vercel/Production - set appropriate values

# Database URL (optional - uses SQLite locally, in-memory on Vercel)
# For production, use: postgresql://user:password@host:port/dbname
# DATABASE_URL=sqlite:///./vectorshield.db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Environment
ENVIRONMENT=development
# Set to 'production' when deploying to Vercel

# Auth
# Secret used to sign hospital login tokens - set a long random value in production
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Master admin account (auto-created on first backend startup if it doesn't exist yet)
# This is the login that approves/rejects new hospital signups
ADMIN_EMAIL=admin@vectorshield.local
ADMIN_PASSWORD=VectorShieldAdmin!2026
